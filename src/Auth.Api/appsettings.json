{
  "ConnectionStrings": {
    "Auth": "Data Source=auth.db"
  },
  "Jwt": {
    "Issuer": "Auth.Api",
    "Audience": "Auth.Api.Client",
    "AccessTokenMinutes": 15,
    "SessionDays": 7
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
